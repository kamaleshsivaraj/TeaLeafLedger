# TeaLeafLedger Database Configuration
# Copy to .env and fill in your real credentials.
# PostgreSQL (PRIMARY DATABASE)
DB_URL=jdbc:postgresql://localhost:5432/tealeafledger
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# MongoDB (SEED/REFERENCE DATA)
MONGO_URI=mongodb://localhost:27017/tealeafledger_seed

# Gmail SMTP for verification/OTP emails.
# Use an App Password from https://myaccount.google.com/apppasswords
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USER_MAIL=your.gmail.address@gmail.com
GMAIL_USER_PASSWORD=your_16_char_app_password
GMAIL_FROM_MAIL=your.gmail.address@gmail.com

# SMS OTP (optional). Empty = fallback "demo code" shown in the app.
# provider: fast2sms (free trial) | empty for demo/log mode
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=TeaLeaf